# Values are substituted by Portainer from the stack environment.
# The real values live in the Portainer stack env, NOT in git.
# Copy this file's keys into the Portainer stack env for stack "glance-swarm".

# Base64 of exactly 64 random bytes. Signs the Glance session cookie.
# Generate with: openssl rand -base64 64 | tr -d '\n'
GLANCE_SECRET_KEY=REDACTED

# bcrypt hash of the dashboard login password.
# The SAME password is used for the Homepage dashboard (dash.echoinggreen.net),
# so one credential covers both dashboards.
# Generate with: python3 -c "import bcrypt;print(bcrypt.hashpw(b'PW', bcrypt.gensalt()).decode())"
GLANCE_PASSWORD_HASH=REDACTED
